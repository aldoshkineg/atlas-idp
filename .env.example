# Atlas IDP local secret store template (copy to .env, fill in, never commit).
# Uploaded to GitHub as one secret ENV_FILE via `make gh-seed`.

# Vault platform seeds (written into in-cluster Vault by the vault-seeds step)
VAULT_TOKEN=              # Vault auth token — local `vault` CLI only
VL_MINIO_ROOT_USER=       # MinIO root user
VL_MINIO_ROOT_PASSWORD=   # MinIO root password
VL_REDIS_PASSWORD=        # Redis password (External Secrets)
VL_GRAFANA_PASSWORD=      # Grafana admin password

# Embedded file secrets (base64). Generate with:
#   ATLAS_CA_CRT_B64=$(base64 -w0 < security/certs/ca.crt)
ATLAS_CA_CRT_B64=
ATLAS_CA_KEY_B64=
COSIGN_PRIVATE_KEY_B64=
